[Unit]
Description=Simple Desktop Display Manager
Documentation=man:sddm https://wiki.archlinux.org/title/SDDM
After=systemd-user-sessions.service systemd-logind.service
# Inert until the Plasma settings are in the ace nix profile (setup-plasma.sh).
# Falls back to the console login cleanly before that.
ConditionPathExists=/home/ace/.nix-profile/bin/sddm

[Service]
ExecStart=/usr/lib/arcex/start-sddm.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
Alias=display-manager.service